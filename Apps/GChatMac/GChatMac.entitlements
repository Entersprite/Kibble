<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sandboxed from the start. Turning it on later, once a WKWebView is
	     capturing cookies and a database is on disk, means discovering every
	     path problem at once. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The bridge talks to chat.google.com. Nothing needs it yet - the
	     fixture backend has no network - but the app it is becoming does. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- A downloaded file goes to Downloads unless the person picks a folder. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
	<!-- The folder picked in Settings, and the destination of Save As. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keeps the picked folder across launches, as a security-scoped bookmark. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Sparkle's installer and status services, which a sandboxed app reaches
	     by name. Sparkle's own documentation, "Sandboxing". -->
	<key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spks</string>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)-spki</string>
	</array>
	<!-- Sparkle.framework is a library in the bundle. Library validation accepts
	     only Apple's code or the app's own Team ID, and a self-signed certificate
	     has none, so without this the hardened runtime refuses Sparkle at launch
	     (measured: "different Team IDs"). The hardened runtime still blocks
	     DYLD_INSERT_LIBRARIES. Debug has no hardened runtime, so it changes
	     nothing there. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
