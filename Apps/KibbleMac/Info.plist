<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>Copyright © 2026 Mark Guzmics. MIT License.</string>
	<key>NSCameraUsageDescription</key>
	<string>Kibble uses your camera during calls you choose to join.</string>
	<key>NSFocusStatusUsageDescription</key>
	<string>Kibble checks whether a Focus is on when a call comes in, and sends a notification instead of its call panel so macOS can decide whether to show it.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Kibble uses your microphone during calls you choose to join.</string>
	<!-- Updates (Sparkle). YES in Release only, so a development build never
	     replaces itself with the last release. -->
	<key>KibbleUpdatesEnabled</key>
	<string>$(KIBBLE_UPDATES_ENABLED)</string>
	<!-- The newest non-prerelease GitHub Release's appcast: main only. -->
	<key>SUFeedURL</key>
	<string>https://github.com/Entersprite/Kibble/releases/latest/download/appcast.xml</string>
	<key>SUPublicEDKey</key>
	<string>vBK8/9xFIk4d33QIzxDRneDl7ego48myeuyL4dtZAN8=</string>
	<!-- Required for a sandboxed app: the install runs in Sparkle's XPC service. -->
	<key>SUEnableInstallerLauncherService</key>
	<true/>
	<!-- On without Sparkle's second-launch prompt; Settings › Updates is where it changes. -->
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<!-- Background downloads whatever Sparkle's scheduler says, so the launch
	     check downloads under Never too; Settings › Updates decides when. -->
	<key>SUAllowsAutomaticUpdates</key>
	<true/>
	<key>SUScheduledCheckInterval</key>
	<integer>86400</integer>
</dict>
</plist>
