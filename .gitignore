# macOS
.DS_Store

# Swift / SwiftPM
.build/
.swiftpm/

# Xcode (project is GENERATED by xcodegen — never commit or hand-edit it)
*.xcodeproj/
DerivedData/
*.xcuserdatad/

# Release zips, built by scripts/package.sh and attached to GitHub Releases
/dist/

# Local build config (signing identity, secrets)
Config/Local.xcconfig

# Third-party reference source: AGPL-3.0, do not vendor into this tree
reference/

# Protocol captures containing REAL account data — colleagues' messages and
# names. Only Fixtures/shape/ (JSONShape-redacted) may ever be committed.
Fixtures/raw/

# Session credentials
*cookies*.json
*.p12

# Private material lives in the separate KibbleDocs repository. Local links
# created by scripts/setup-private-docs.sh must never enter this public tree.
/docs/
/docs
/Spikes/
/Spikes
/.superpowers/
/.superpowers
/reference
