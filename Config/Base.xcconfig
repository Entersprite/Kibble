// Shared build settings. Committed.
//
// Machine-specific values (your OAuth client ID) belong in Local.xcconfig,
// which is gitignored and included at the bottom so it overrides the defaults.

MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete

// Written by scripts/release.sh, never by hand: vYEAR.WEEK.N, the ISO week and
// that week's release count from 0. The build number is the same three integers.
MARKETING_VERSION = 2026.41.7
CURRENT_PROJECT_VERSION = 2026.41.7

// Ad hoc signing by default, so the app builds with no Apple account. build.sh
// prefers the owner's Developer ID, found in the Keychain at run time (no name
// or Team ID is written into the repository), then the self-signed identity
// scripts/create-dev-cert.sh creates. A stable identity matters because ad hoc
// signatures change with every build, and macOS then re-prompts for Keychain
// access every single time.
CODE_SIGN_STYLE = Manual
DEVELOPMENT_TEAM =

// Project-wide default. Must stay ad hoc: SwiftPM dependency targets inherit
// this, and a named identity on their resource bundles makes Xcode demand a
// development team for them.
CODE_SIGN_IDENTITY = -

// Applied to the KibbleMac target only (project.yml). scripts/build.sh sets
// both from the Keychain when it finds an identity.
KIBBLE_SIGN_IDENTITY = -
KIBBLE_TEAM =

// Placeholders — override in Local.xcconfig once the GCP OAuth client exists.
// Google requires the secret in the token exchange for Desktop-app clients, even
// though PKCE is used and the secret is not confidential for installed apps.
GOOGLE_OAUTH_CLIENT_ID = REPLACE_WITH_YOUR_DESKTOP_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET = REPLACE_WITH_YOUR_DESKTOP_CLIENT_SECRET

#include? "Local.xcconfig"
